{
    "name": "liberusoftware/ecommerce-fulfillment-livewire",
    "description": "Livewire 4 storefront parcel tracking for liberusoftware/ecommerce-fulfillment: every parcel raised against one of the shopper's own orders, on as many carriers and as many days as it took, with progress read off the domain's committed and dispatched counters and no control that writes anything.",
    "type": "liberu-module",
    "license": "MIT",
    "version": "0.1.0",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/liberusoftware/module-ecommerce-fulfillment"
        }
    ],
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "livewire/livewire": "^4.0",
        "liberusoftware/ecommerce-fulfillment": "^0.1"
    },
    "require-dev": {
        "liberusoftware/ecommerce-fulfillment": "^0.1",
        "liberusoftware/package-testbench": "^1.7",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Ecommerce\\Fulfillment\\Livewire\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Ecommerce\\Fulfillment\\Livewire\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "ecommerce-fulfillment-livewire"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
